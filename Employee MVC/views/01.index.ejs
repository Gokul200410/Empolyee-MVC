<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Empolyee Management</title>
</head>
<body>

    <!-- Header -->
    <header>
        <h1>Empolyee Management Portal</h1>
        <p>Manage Empolyee Data Easily</p>
    </header>

    <!-- Main content -->
    <main>
        <!-- Form to Search Empolyee -->
        <section>
            <form action="/search-empolyee" method="GET">
                <input type="number" name="id" placeholder="Enter Id Number..." required>
                <button type="submit">Search</button>
            </form>
        </section>

        <!-- Table of Empolyees -->
        <section>
            <h2>All Empolyees</h2>
            <table>
                <thead>
                    <tr>
                        <th>Id No</th>
                        <th>Name</th>
                        <th>Age</th>
                        <th>Designation</th>
                        <th>Salary</th>
                        <th>Experience</th>
                    </tr>
                </thead>
                <tbody>
                    <% empolyee.forEach(empolyee => { %>
                    <tr>
                        <td><%= empolyee.id %></td>
                        <td><%= empolyee.name %></td>
                        <td><%= empolyee.age %></td>
                        <td><%= empolyee.designation></td>
                        <td><%= empolyee.salary %></td>
                        <td><%= empolyee.experience %></td>
                        <td>
                            <form action="/delete-empolyee/<%= empolyee.id %>" method="POST">
                                <button type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </section>

        <!-- Form to Add Empolyee -->
        <section>
            <h2>Add New Empolyee</h2>
            <form action="/submit-empolyee" method="POST">
                <div>
                    <label for="id">Id</label>
                    <input type="number" id="id" name="id" required>
                </div>

                <div>
                    <label for="name">Name</label>
                    <input type="text" id="name" name="name" required>
                </div>

                <div>
                    <label for="age">Age</label>
                    <input type="number" id="age" name="age" required>
                </div>

                <div>
                    <label for="designation">Your Designation</label>
                    <input type="text" id="designation" name="designation" required>
                </div>

                <div>
                    <label for="salary">Salary/label>
                    <input type="number" id="salary" name="salary" required>
                </div>
                <div>
                    <label for="experience">Experience</label>
                    <input type="number" id="experience" name="experience" required>
                </div>

                <button type="submit">Submit Empolyee</button>
            </form>
        </section>
    </main>

    <!-- Footer -->
    <footer>
        <p>&copy; 2025 Empolyee Portal. All rights reserved.</p>
    </footer>

</body>
</html>
