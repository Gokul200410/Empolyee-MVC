<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Empolyee Found</title>
</head>
<body>

    <!-- Header -->
    <header>
        <h1>Empolyee Found</h1>
        <p>Here are the details of the searched empolyee</p>
    </header>

    <!-- Main Content -->
    <main>
        <div>
            <h2>Empolyee Details</h2>

            <div>
                <div>
                    <p>ID:</p>
                    <p><%= empolyee.id %></p>
                </div>

                <div>
                    <p>Name:</p>
                    <p><%= empolyee.name %></p>
                </div>

                <div>
                    <p>Age:</p>
                    <p><%= empolyee.age %></p>
                </div>

                <div>
                    <p>Designation:</p>
                    <p><%= empolyee.designation %></p>
                </div>

                <div>
                    <p>Salary:</p>
                    <p><%= empolyee.salary %></p>
                </div>

                <div>
                    <p>Experience:</p>
                    <p><%= empolyee.experience %></p>
                </div>
            </div>

            <div>
                <a href="/">Go Back</a>
            </div>
        </div>
    </main>
</body>
</html>
